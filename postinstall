#!/bin/bash
set -e
# npm adds dependency binaries to PATH, including hoisted dependencies.
# Build from source: the configured prebuilt tarballs are not published.
# node-pre-gyp supplies the module_name/module_path variables binding.gyp needs.
node-pre-gyp rebuild
# These bindings are required at runtime; compilation failure must fail install.
tsc -p ./tsconfig.json
